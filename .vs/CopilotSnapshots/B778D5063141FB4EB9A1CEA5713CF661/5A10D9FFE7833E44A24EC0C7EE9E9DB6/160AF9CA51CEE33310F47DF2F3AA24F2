using OpenQA.Selenium;

namespace MachineEngine_Task.Pages
{

    public class DashboardPage : BasePage
    {

        public DashboardPage(IWebDriver driver) : base(driver)
        {
        }

        // Consolidated cookie actions into a single method using a switch-case.
        // action values (case-insensitive): "allowall", "allowselection", "deny"
        public void HandleCookies(string action)
        {
            if (string.IsNullOrWhiteSpace(action))
                throw new ArgumentException("action must be provided", nameof(action));

            switch (action.Trim().ToLowerInvariant())
            {
                case "allowall":
                    var ck_allowAll = Driver.FindElement(By.Id("CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll"));
                    ck_allowAll.Click();
                    break;

                case "allowselection":
                    var ck_allowSelect = Driver.FindElement(By.Id("CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection"));
                    ck_allowSelect.Click();
                    break;

                case "deny":
                    var ck_Deny = Driver.FindElement(By.Id("CybotCookiebotDialogBodyButtonDecline"));
                    ck_Deny.Click();
                    break;

                default:
                    throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown cookie action");
            }
        }

        public void SolutiionsLink()
        {
            var clk_SolLink = Driver.FindElement(By.CssSelector("span#nav-toggle-solutions.MainNavLink_linkEl__ZECPn"));
            clk_SolLink.Click();


        }
    }
}
